{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "presentation"],
  "properties": {
    "version": { "const": 1 },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "blocks", "scenarios"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/block" } },
        "functions": { "type": "array", "items": { "$ref": "#/$defs/function" } },
        "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenario" } },
        "behaviorAreas": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/behaviorArea" } }
      }
    },
    "references": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
    "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } }
  },
  "$defs": {
    "range": {
      "type": "object", "additionalProperties": false, "required": ["startLine", "endLine"],
      "properties": {
        "startLine": { "type": "integer", "minimum": 1 }, "endLine": { "type": "integer", "minimum": 1 },
        "startColumn": { "type": "integer", "minimum": 1 }, "endColumn": { "type": "integer", "minimum": 1 }
      }
    },
    "scaffolding": {
      "allOf": [
        { "$ref": "#/$defs/range" },
        { "type": "object", "required": ["label"], "properties": { "label": { "type": "string", "minLength": 1 } } }
      ]
    },
    "block": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "symbol", "path", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["class", "struct"] },
        "symbol": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "codeTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["behavior", "contract", "structure", "wiring"] } },
        "parentId": { "type": "string", "minLength": 1 },
        "focus": { "type": "array", "items": { "$ref": "#/$defs/range" } },
        "scaffolding": { "type": "array", "items": { "$ref": "#/$defs/scaffolding" } }
      }
    },
    "participant": {
      "type": "object", "additionalProperties": false, "required": ["blockId", "role"],
      "properties": { "blockId": { "type": "string", "minLength": 1 }, "role": { "type": "string", "minLength": 1 } }
    },
    "function": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "symbol", "path", "ownerBlockId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "symbol": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }, "role": { "type": "string", "minLength": 1 },
        "codeTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["behavior", "contract", "structure", "wiring"] } },
        "ownerBlockId": { "type": "string", "minLength": 1 },
        "focus": { "type": "array", "items": { "$ref": "#/$defs/range" } }
      }
    },
    "scenarioFunction": {
      "type": "object", "additionalProperties": false, "required": ["functionId", "role"],
      "properties": { "functionId": { "type": "string", "minLength": 1 }, "role": { "type": "string", "minLength": 1 } }
    },
    "scenarioStep": {
      "type": "object", "additionalProperties": false, "required": ["id", "functionId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "functionId": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "children": { "type": "array", "items": { "$ref": "#/$defs/scenarioStep" } }
      }
    },
    "coverageCase": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "capability": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "promise", "scenarioIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "promise": { "type": "string", "minLength": 1 },
        "scenarioIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "behaviorArea": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "capabilities"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "capabilities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/capability" } }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["kind", "label", "path", "line"],
      "properties": {
        "kind": { "enum": ["specification", "coverage", "main", "documentation"] },
        "label": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 }, "column": { "type": "integer", "minimum": 1 }
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "actor", "startingState", "action", "result", "participants", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 },
        "actor": { "type": "string", "minLength": 1 }, "startingState": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 }, "result": { "type": "string", "minLength": 1 },
        "participants": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/participant" } },
        "functions": { "type": "array", "items": { "$ref": "#/$defs/scenarioFunction" } },
        "sequence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenarioStep" } },
        "coverageCases": { "type": "array", "items": { "$ref": "#/$defs/coverageCase" } },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "position": {
      "type": "object", "additionalProperties": false, "required": ["path", "line", "column"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }, "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }, "length": { "type": "integer", "minimum": 1 },
        "role": { "enum": ["type", "function", "constant", "field"] }
      }
    },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["kind", "symbol", "path"],
      "properties": { "kind": { "enum": ["class", "struct", "enum", "function", "field"] }, "symbol": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 } }
    },
    "reference": {
      "type": "object", "required": ["source"],
      "properties": { "source": { "$ref": "#/$defs/position" }, "target": { "$ref": "#/$defs/target" }, "origin": { "type": "string", "minLength": 1 } },
      "oneOf": [{ "required": ["target"], "not": { "required": ["origin"] } }, { "required": ["origin"], "not": { "required": ["target"] } }]
    },
    "relationship": {
      "type": "object", "additionalProperties": false, "required": ["kind", "from", "to", "sites"],
      "properties": {
        "kind": { "enum": ["calls", "reads", "writes"] }, "from": { "$ref": "#/$defs/target" }, "to": { "$ref": "#/$defs/target" },
        "sites": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/position" } }, "certainty": { "enum": ["direct", "possible"] }
      }
    }
  }
}
